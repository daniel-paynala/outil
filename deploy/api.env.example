# Copie en /var/www/arche/source/api/.env et remplis les <...>
APP_NAME=Arche
APP_ENV=production
APP_KEY=base64:<générer avec: php artisan key:generate --show>
APP_DEBUG=false
# UTC, et jamais autre chose. Les colonnes `timestamp` de Supabase ne portent
# aucun fuseau : ce que Laravel y écrit, le client le relit tel quel en le
# supposant UTC. Une autre valeur ici décale silencieusement tout l'historique
# — c'est exactement ce qui est arrivé avec Europe/Paris.
APP_TIMEZONE=UTC
APP_URL=http://<TON_IP_PUBLIQUE>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ─── Supabase Postgres (pooler IPv4) ───
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.belefuxwpmheownynmyv
DB_PASSWORD=<ton mot de passe>
DB_SSLMODE=require

# ─── Supabase API ───
SUPABASE_URL=https://belefuxwpmheownynmyv.supabase.co
SUPABASE_JWT_SECRET=<ton JWT secret>
SUPABASE_ANON_KEY=<ton anon key>
SUPABASE_SERVICE_ROLE_KEY=<ton service_role key>

# ─── Cache + queue + session ───
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── CORS ───
# Le front est sur la même IP, en path /, donc origin = http://<IP>
SANCTUM_STATEFUL_DOMAINS=<TON_IP_PUBLIQUE>

# ─── Search (Meilisearch) ───
# Désactivé en prod t3.micro pour économiser RAM
SCOUT_DRIVER=collection
# Quand tu auras une instance plus grosse :
# SCOUT_DRIVER=meilisearch
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=<masterKey>

# ─── Mail (Mailgun EU) ───
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="noreply@paynala.com"
MAIL_FROM_NAME="Paynala"

MAILGUN_DOMAIN=paynala.com
MAILGUN_SECRET=<ton api key Mailgun (Basic api:xxxx)>
MAILGUN_ENDPOINT=api.eu.mailgun.net

# ─── Notifications push (OneSignal) ───
# App ID : public, il part aussi dans le binaire mobile.
# Clé REST : SECRET SERVEUR — elle permet d'écrire à n'importe quel
# utilisateur de l'app. Elle n'a rien à faire côté client.
# Vides, l'envoi est simplement ignoré : la messagerie fonctionne sans push.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# ─── Relais d'appel (coturn) ───
#
# ATTENTION : surtout pas un nom proxifié par Cloudflare.
#
# `arche.paynala.com` résout vers Cloudflare, qui ne relaie ni l'UDP 3478 ni le
# TCP 3478/5349. Un client TURN visant ce nom n'obtient aucune réponse, la
# négociation se rabat sur le direct, et les appels échouent partout où le
# direct ne passe pas — c'est-à-dire sur la plupart des réseaux mobiles.
#
# La panne est parfaitement silencieuse : la sonde de monitoring voit bien des
# identifiants signés, l'application les reçoit, et personne ne dit que le
# relais ne répond pas.
#
# Il faut donc un nom qui pointe **directement** sur le VPS — enregistrement
# DNS avec le nuage gris, non proxifié — ou l'adresse IP du VPS.
#
# Liste séparée par des virgules, du plus proche au plus lointain. L'ordre
# compte : c'est lui qui départage quand deux relais aboutissent.
#
#   TURN_HOSTS=turn.paynala.ga,turn.paynala.com
#
# Le secret doit être identique à `static-auth-secret` sur *chaque* coturn.
# Vides, les appels fonctionnent quand même — simplement pas partout.
TURN_HOSTS=
TURN_SECRET=
